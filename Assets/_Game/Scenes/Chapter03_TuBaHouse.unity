  m_Script: {fileID: 11500000, guid: fbdc62c20d9803047a1c8352abd9e0c9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.DocumentSequence
  _id: document_contract
  _view: {fileID: 144353176}
  _title: "V\u0102N T\u1EF0 B\xC1N TH\xC2N"
  _body: "Ng\u01B0\u1EDDi b\xE1n: <b>M\xE3 Gi\xE1m Sinh</b>, ng\u01B0\u1EDDi huy\u1EC7n L\xE2m Thanh.\nNg\u01B0\u1EDDi mua: <b>T\xFA B\xE0</b>, ch\u1EE7 l\u1EA7u xanh L\xE2m Tri.\n\nNg\u01B0\u1EDDi b\u1ECB b\xE1n: <b>V\u01B0\u01A1ng Th\xFAy Ki\u1EC1u</b>, m\u01B0\u1EDDi l\u0103m tu\u1ED5i,\nbi\u1EBFt ch\u1EEF, gi\u1ECFi \u0111\xE0n, gi\u1ECFi th\u01A1.\n\nGi\xE1 b\xE1n: <b>b\u1ED1n tr\u0103m n\u0103m m\u01B0\u01A1i l\u1EA1ng b\u1EA1c</b>.\nT\u1EEB nay ng\u01B0\u1EDDi mua to\xE0n quy\u1EC1n \u0111\u1ECBnh \u0111o\u1EA1t n\u01A1i \u1EDF\nv\xE0 c\xF4ng vi\u1EC7c c\u1EE7a ng\u01B0\u1EDDi b\u1ECB b\xE1n.\n\n\u0110i\u1EC3m ch\u1EC9 l\xE0m b\u1EB1ng."
  _sealed: 1
  _prop: {fileID: 0}
