  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.EavesdropSequence
  _id: eavesdrop_c3
  _zone: {fileID: 1233508663}
  _start: {fileID: 644741900}
  _sensors:
  - {fileID: 371863575}
  - {fileID: 1326955528}
  - {fileID: 1456849755}
  _guard: {fileID: 371863574}
  _glancers:
  - {fileID: 1326955526}
  - {fileID: 1456849753}
  _glanceTarget: {fileID: 566378736}
  _glanceLines:
  - "H\u1EEBm... ngo\xE0i c\u1EEDa s\u1ED5 c\xF3 ai \u0111\u1EA5y?"
  - "Khoan \u0111\xE3. H\xECnh nh\u01B0 c\xF3 ti\u1EBFng \u0111\u1ED9ng."
  _seconds: 8
  _objective: "L\u1EBBn qua b\u1ED3n hoa, khom ng\u01B0\u1EDDi d\u01B0\u1EDBi b\u1EADu c\u1EEDa s\u1ED5 ph\xF2ng T\xFA B\xE0 v\xE0 nghe l\xE9n"
  _caughtDetail: "B\u1EA1n \u0111\xE3 b\u1ECB th\u1EA5y d\u01B0\u1EDBi c\u1EEDa s\u1ED5. Canh l\xFAc ng\u01B0\u1EDDi canh quay \u0111i, v\xE0 lu\xF4n khom ng\u01B0\u1EDDi: \u0111\u1EE9ng th\u1EB3ng l\xE0 ng\u01B0\u1EDDi trong ph\xF2ng nh\xECn qua b\u1EADu c\u1EEDa th\u1EA5y ngay."
  _musicAfter: tuba_warm
