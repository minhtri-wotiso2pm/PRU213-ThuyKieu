  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_house
  _body: "<color=#E8C27A>T\u1EF1 do kh\xE1m ph\xE1</color> ng\xF4i nh\xE0 theo th\u1EE9 t\u1EF1 b\u1EA1n mu\u1ED1n. Danh s\xE1ch vi\u1EC7c c\xF3 th\u1EC3 l\xE0m hi\u1EC7n \u1EDF g\xF3c tr\xE1i.\n\nS\xE2n trong v\xE0 h\xE0nh lang l\xE0 n\u01A1i b\u1EA1n \u0111\u01B0\u1EE3c \u0111i l\u1EA1i. <color=#F08080>Ph\xF2ng s\u1ED5 s\xE1ch</color> v\xE0 <color=#F08080>c\u1EEDa s\u1ED5 ph\xF2ng T\xFA B\xE0</color> l\xE0 khu v\u1EF1c c\u1EA5m.\n\nNg\u01B0\u1EDDi canh c\xF3 <color=#F08080>t\u1EA7m nh\xECn h\xECnh n\xF3n</color> \u0111\u1ECF d\u01B0\u1EDBi ch\xE2n. \u1EDE khu v\u1EF1c c\u1EA5m, \u0111\u1EEBng \u0111\u1EC3 h\u1EAFn th\u1EA5y b\u1EA1n; <color=#E8C27A>khom ng\u01B0\u1EDDi (Ctrl)</color> \u0111\u1EC3 kh\xF3 b\u1ECB ph\xE1t hi\u1EC7n, n\u1EA5p sau b\xE0n gh\u1EBF, b\u1ED3n hoa."
  _controlsHint: 
