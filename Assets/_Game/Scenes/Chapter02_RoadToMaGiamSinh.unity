  m_Script: {fileID: 11500000, guid: fbdc62c20d9803047a1c8352abd9e0c9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.DocumentSequence
  _id: document_paper
  _view: {fileID: 1951375093}
  _title: "M\u1EA9u gi\u1EA5y g\u1EA5p t\u01B0"
  _body: "G\u1EEDi B\xE0 T. \u1EDF L\xE2m Tri,\n\nH\xE0ng \u0111\xE3 nh\u1EADn, giao trong ba ng\xE0y.\nNhan s\u1EAFc h\u01A1n ng\u01B0\u1EDDi, c\u1EA7m k\u1EF3 thi h\u1ECDa \u0111\u1EC1u th\u1EA1o.\n\nGi\xE1: <b>b\u1ED1n tr\u0103m n\u0103m m\u01B0\u01A1i l\u1EA1ng</b>.\nTi\u1EC1n trao \u2014 ng\u01B0\u1EDDi giao.\n\n\u2014 M\xE3"
  _sealed: 1
  _prop: {fileID: 797119199}
