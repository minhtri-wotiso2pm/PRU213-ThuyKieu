  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_road
  _body: "<color=#E8C27A>\u0110i theo M\xE3 Gi\xE1m Sinh</color> v\xE0 t\xECm hi\u1EC3u h\u1EAFn \u2014 nh\u01B0ng \u0111\u1EEBng \u0111\u1EC3 h\u1EAFn sinh nghi.\n\n<color=#E8C27A>Gi\u1EEF chu\u1ED9t ph\u1EA3i</color>: quan s\xE1t k\u1EF9. Gi\u1EEF t\xE2m nh\xECn l\xEAn m\u1EE5c ti\xEAu cho \u0111\u1EBFn khi \u0111\u1EA7y.\n<color=#E8C27A>E</color>: b\u1EAFt chuy\u1EC7n, nh\u1EB7t \u0111\u1ED3.   <color=#E8C27A>Ctrl / C</color>: khom ng\u01B0\u1EDDi, \u0111i r\xF3n r\xE9n.\n<color=#E8C27A>J</color>: s\u1ED5 tay manh m\u1ED1i.\n\nThanh <color=#F08080>Nghi ng\u1EDD</color> t\u0103ng khi b\u1EA1n t\u1EE5t l\u1EA1i qu\xE1 xa, ho\u1EB7c nh\xECn ch\u1EB1m ch\u1EB1m khi h\u1EAFn \u0111ang nh\xECn l\u1EA1i."
  _controlsHint: 
