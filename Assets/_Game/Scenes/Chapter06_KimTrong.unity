--- !u!114 &1709946457
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1709946455}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_street
  _body: "<color=#E8C27A>L\u1EADp h\u1ED3 s\u01A1:</color> t\xECm ng\u01B0\u1EDDi l\xE0m ch\u1EE9ng v\xE0 b\u1EB1ng ch\u1EE9ng tr\xEAn ph\u1ED1 huy\u1EC7n, theo th\u1EE9 t\u1EF1 b\u1EA1n mu\u1ED1n.\n\n\u2022 M\u1ED7i ng\u01B0\u1EDDi c\u1EA7n th\u1EA5y <color=#E8C27A>\u0111\xFAng th\u1EE9 h\u1ECD hi\u1EC3u \u0111\u01B0\u1EE3c</color>: \u0111\u01B0a sai gi\u1EA5y t\u1EDD hai l\u1EA7n l\xE0 h\u1ECD kh\xF4ng n\xF3i n\u1EEFa.\n\u2022 Kim Tr\u1ECDng \u0111i c\u1EA1nh b\u1EA1n; khi ch\xE0ng \u0111\u1EE7 tin b\u1EA1n, ch\xE0ng s\u1EBD \u0111\u1EE9ng ra n\xF3i gi\xFAp.\n\u2022 Ng\u01B0\u1EDDi c\u1EE7a T\xFA B\xE0 \u0111ang t\xECm b\u1EA1n tr\xEAn ph\u1ED1. <color=#F08080>\u0110\u1EEBng ch\u1EA1y</color>, v\xE0 \u0111\u1EEBng \u0111i s\xE1t m\u1EB7t h\u1EAFn: l\u1EA1i g\u1EA7n qu\xE1 l\xE0 h\u1EAFn nh\u1EADn ra. Th\u1EA5y d\u1EA5u <color=#E8C27A>?</color> th\xEC quay \u0111i ho\u1EB7c <color=#E8C27A>E</color> n\xE9p sau chum, b\u1EA3ng c\xE1o th\u1ECB.\n\u2022 \u0110\u1EE7 hai n\u01A1i r\u1ED3i th\xEC c\xF3 th\u1EC3 v\u1EC1 th\u01B0 ph\xF2ng s\u1EAFp x\u1EBFp h\u1ED3 s\u01A1."
  _controlsHint: "WASD: \u0111i \xB7 E: n\xF3i chuy\u1EC7n / t\u01B0\u01A1ng t\xE1c / n\xE9p \xB7 Chu\u1ED9t ph\u1EA3i: quan s\xE1t \xB7 J: s\u1ED5 tay \xB7 \u0110\u1EEBng ch\u1EA1y, \u0111\u1EEBng l\u1EA1i g\u1EA7n ng\u01B0\u1EDDi c\u1EE7a T\xFA B\xE0"
