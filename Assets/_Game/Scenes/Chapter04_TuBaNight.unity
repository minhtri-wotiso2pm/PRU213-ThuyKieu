--- !u!114 &833698631
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 833698629}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_night
  _body: "<color=#E8C27A>\u0110\xEAm nay ch\u1EC9 ph\xF2ng b\u1EA1n v\xE0 hi\xEAn ph\xEDa t\xE2y l\xE0 an to\xE0n.</color> Ra s\xE2n l\xE0 ng\u01B0\u1EDDi canh c\xF3 th\u1EC3 th\u1EA5y b\u1EA1n; s\u1EA3nh, b\u1EBFp v\xE0 c\xE1c ph\xF2ng l\xE0 khu v\u1EF1c c\u1EA5m.\n\n\u0110i trong <color=#E8C27A>b\xF3ng t\u1ED1i</color> gi\u1EEFa c\xE1c qu\u1EA7ng \u0111\xE8n: \u0111\u1EE9ng d\u01B0\u1EDBi \u0111\xE8n l\u1ED3ng l\xE0 b\u1ECB th\u1EA5y r\u1EA5t nhanh (xem thanh \xE1nh s\xE1ng d\u01B0\u1EDBi m\xE0n h\xECnh). Khom ng\u01B0\u1EDDi (Ctrl) \u0111\u1EC3 r\xF3n r\xE9n.\n<color=#E8C27A>E</color> \u0111\u1EC3 n\u1EA5p sau chum v\u1EA1i, m\xE0nh tre, t\u1EE7 \xE1o. <color=#E8C27A>Q</color> n\xE9m s\u1ECFi \u0111\u1EC3 d\u1EE5 ng\u01B0\u1EDDi canh \u0111i ch\u1ED7 kh\xE1c.\nD\u1EA5u <color=#E8C27A>?</color> tr\xEAn \u0111\u1EA7u l\xE0 \u0111ang nghi, d\u1EA5u <color=#F08080>!</color> l\xE0 s\u1EAFp b\u1ECB ph\xE1t hi\u1EC7n."
  _controlsHint: "WASD: \u0111i \xB7 Ctrl: khom \xB7 E: t\u01B0\u01A1ng t\xE1c / tr\u1ED1n \xB7 Q: n\xE9m s\u1ECFi \xB7 Chu\u1ED9t ph\u1EA3i: quan s\xE1t \xB7 J: s\u1ED5 tay"
