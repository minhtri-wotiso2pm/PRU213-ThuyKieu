  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_escape
  _body: "<color=#E8C27A>S\xE2n sau:</color> ng\u01B0\u1EDDi canh c\u1EA7m \u0111\xE8n l\u1ED3ng \u0111i tu\u1EA7n, con ch\xF3 x\xEDch c\u1EA1nh c\u1EEDa ng\xF5.\n\n\u2022 \u0110i trong b\xF3ng t\u1ED1i, sau d\xE2y ph\u01A1i qu\u1EA7n \xE1o; <color=#E8C27A>khom ng\u01B0\u1EDDi (Ctrl)</color> khi \u0111i g\u1EA7n con ch\xF3 \u2014 \u0111i th\u1EB3ng l\u01B0ng hay ch\u1EA1y l\xE0 n\xF3 s\u1EE7a.\n\u2022 \u1EDE c\u1EEDa ng\xF5, <color=#E8C27A>gi\u1EEF E</color> \u0111\u1EC3 \u0111\u1EA9y c\u1EEDa. Th\u1EA3 tay tr\u01B0\u1EDBc khi v\u1EA1ch \"ti\u1EBFng b\u1EA3n l\u1EC1\" \u0111\u1EA7y, kh\xF4ng th\xEC c\u1EEDa k\xEAu.\n\u2022 <color=#E8C27A>E</color> \u0111\u1EC3 n\u1EA5p sau \u0111\u1ED1ng r\u01A1m, \u0111\u1ED1ng c\u1EE7i, chu\u1ED3ng g\xE0."
  _controlsHint: "WASD: \u0111i \xB7 Ctrl: khom \xB7 E (gi\u1EEF): \u0111\u1EA9y c\u1EEDa \xB7 E: n\u1EA5p \xB7 J: s\u1ED5 tay"
