  m_Script: {fileID: 11500000, guid: fbdc62c20d9803047a1c8352abd9e0c9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.DocumentSequence
  _id: document_deal
  _view: {fileID: 344931611}
  _title: "GIAO K\xC8O"
  _body: "L\u1EADp ng\xE0y m\xF9ng ch\xEDn th\xE1ng Gi\xEAng.\n\nB\xEAn giao ng\u01B0\u1EDDi: <b>M\xE3 Gi\xE1m Sinh</b>, chuy\xEAn lo vi\u1EC7c \"h\u1ECFi v\u1EE3\" \u1EDF c\xE1c huy\u1EC7n.\nB\xEAn nh\u1EADn ng\u01B0\u1EDDi: <b>T\xFA B\xE0</b>, l\u1EA7u xanh L\xE2m Tri.\n\nM\u1ED7i ng\u01B0\u1EDDi giao \u0111\u1EBFn, T\xFA B\xE0 tr\u1EA3 <b>b\u1ED1n tr\u0103m n\u0103m m\u01B0\u01A1i l\u1EA1ng</b>.\n\n<s>L\xFD th\u1ECB \u2014 huy\u1EC7n \u0110\xF4ng Th\xE0nh</s>\n<s>Tr\u1EA7n th\u1ECB \u2014 huy\u1EC7n V\u0169 L\u0103ng</s>\n<s>L\u01B0u th\u1ECB \u2014 huy\u1EC7n Thanh H\xE0</s>\n\nHai b\xEAn \u0111i\u1EC3m ch\u1EC9 l\xE0m b\u1EB1ng."
  _sealed: 1
  _prop: {fileID: 0}
