  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_room
  _body: "<color=#E8C27A>Quan s\xE1t:</color> gi\u1EEF <color=#E8C27A>chu\u1ED9t ph\u1EA3i</color> \u0111\u1EC3 nh\xECn k\u1EF9 m\u1ED9t th\u1EE9.\n<color=#E8C27A>S\u1ED5 tay:</color> b\u1EA5m <color=#E8C27A>J</color> \u0111\u1EC3 xem l\u1EA1i nh\u1EEFng g\xEC \u0111\xE3 bi\u1EBFt.\n\n\u0110\xE2y l\xE0 ph\xF2ng c\u1EE7a Th\xFAy Ki\u1EC1u. H\xE3y xem quanh ph\xF2ng \u0111\u1EC3 hi\u1EC3u m\xECnh \u0111ang \u1EDF \u0111\xE2u \u2014 r\u1ED3i ra s\xE2n."
  _controlsHint: "WASD: \u0111i \xB7 E: xem \xB7 Chu\u1ED9t ph\u1EA3i: quan s\xE1t \xB7 J: s\u1ED5 tay"
