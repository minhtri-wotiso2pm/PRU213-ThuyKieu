--- !u!114 &1233531061
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1233531059}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_lau
  _body: "B\u1EA1n nh\xECn b\u1EB1ng ch\xEDnh m\u1EAFt Ki\u1EC1u.\n\n<color=#E8C27A>Nh\xECn</color> v\xE0o \u0111\u1ED3 v\u1EADt hay ng\u01B0\u1EDDi r\u1ED3i b\u1EA5m <color=#E8C27A>E</color>. V\u1EDBi c\u1EEDa v\xE0 then: <color=#E8C27A>b\u1EA5m E</color> l\xE0 gi\u1EADt m\u1EA1nh (k\xEAu to), <color=#E8C27A>gi\u1EEF E</color> l\xE0 l\xE0m kh\u1EBD.\n<color=#E8C27A>Ctrl</color> khom ng\u01B0\u1EDDi: b\u01B0\u1EDBc nh\u1EB9, kh\xF3 b\u1ECB th\u1EA5y. <color=#E8C27A>Shift</color> ch\u1EA1y: nhanh nh\u01B0ng vang xa. \u0110\xE1 s\xE2n \u01B0\u1EDBt vang h\u01A1n s\xE0n g\u1ED7.\n\nD\xE3y nh\xE0 sau (ph\xF2ng T\xFA B\xE0, kho v\u1EA3i, ph\xF2ng s\u1ED5 s\xE1ch) l\xE0 <color=#F08080>khu c\u1EA5m</color>. Vi\u1EC1n \u0111\u1ECF \u1EDF m\xE9p m\xE0n h\xECnh l\xE0 c\xF3 ng\u01B0\u1EDDi \u0111ang \u0111\u1EC3 \xFD b\u1EA1n."
  _controlsHint: "WASD: \u0111i \xB7 Shift: ch\u1EA1y \xB7 Ctrl: khom \xB7 E: t\u01B0\u01A1ng t\xE1c \xB7 Chu\u1ED9t ph\u1EA3i: nh\xECn k\u1EF9"
