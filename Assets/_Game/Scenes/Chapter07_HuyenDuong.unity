  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076ca48c8c758304993ad2e6984a6853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThuyKieu.Gameplay.Sequences.TutorialSequence
  _id: tutorial_gate
  _body: "Tr\u01B0\u1EDBc khi \u0111\xE1nh tr\u1ED1ng, b\u1EA1n c\xF3 th\u1EC3 chu\u1EA9n b\u1ECB:\n\u2022 <color=#E8C27A>\u0110\u1ED9ng vi\xEAn c\xE1c nh\xE2n ch\u1EE9ng</color> \u0111\u1EC3 kh\xF4ng ai l\xF9i b\u01B0\u1EDBc khi b\u1ECB d\u1ECDa.\n\u2022 <color=#E8C27A>B\xE0n k\u1EBF v\u1EDBi Kim Tr\u1ECDng</color> (n\u1EBFu ch\xE0ng \u0111\u1EE7 tin b\u1EA1n): ch\xE0ng s\u1EBD c\u1EE9u nguy m\u1ED9t l\u1EA7n.\n\u2022 <color=#E8C27A>\u0110\u1EC3 \xFD T\xFA B\xE0</color>: c\xF3 khi th\u1EA5y \u0111\u01B0\u1EE3c \u0111i\u1EC1u m\u1EE5 mu\u1ED1n gi\u1EA5u.\n\n\u0110\xE1nh tr\u1ED1ng k\xEAu oan r\u1ED3i th\xEC kh\xF4ng quay l\u1EA1i \u0111\u01B0\u1EE3c."
  _controlsHint: "WASD: \u0111i \xB7 E: t\u01B0\u01A1ng t\xE1c \xB7 Chu\u1ED9t ph\u1EA3i: quan s\xE1t \xB7 J: s\u1ED5 tay"
